{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "🌐 Executar API Backend (WorkEzApi)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "program": "${workspaceFolder}/scripts/run-api.js",
      "console": "integratedTerminal"
    },
    {
      "name": "📱 Executar App Mobile (WorkEzApp Expo)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/WorkEzApp",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["expo", "start"],
      "console": "integratedTerminal"
    },
    {
      "name": "💻 Executar App Web (WorkEzApp Web)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/WorkEzApp",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["expo", "start", "--web"],
      "console": "integratedTerminal"
    }
  ],
  "compounds": [
    {
      "name": "🚀 Executar API + App Mobile (Juntos)",
      "configurations": [
        "🌐 Executar API Backend (WorkEzApi)",
        "📱 Executar App Mobile (WorkEzApp Expo)"
      ],
      "stopAll": true
    },
    {
      "name": "🚀 Executar API + Web (Juntos)",
      "configurations": [
        "🌐 Executar API Backend (WorkEzApi)",
        "💻 Executar App Web (WorkEzApp Web)"
      ],
      "stopAll": true
    }
  ]
}